{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trading",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "/api/*",
      "custom_domain": false
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "BACKEND_ORIGIN": ""
  }
}
