{
  // Worker-local config (used when deploying from `trading-worker/`).
  // The repo-root `wrangler.jsonc` mirrors this file with root-relative paths
  // and is what Workers Builds / `npm run deploy` pick up. Keep both in sync.
  "$schema": "node_modules/wrangler/config-schema.json",

  // Must match the Worker in the Cloudflare dashboard — `trading` is the Worker
  // that serves https://trading.rufflocrm.workers.dev. Renaming it here deploys
  // to a *different* Worker, which leaves the live host serving the old build.
  "name": "trading",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",

  // The built SPA (../dist) served with single-page-application fallback.
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // OPTIONAL persistent user/order storage. Without it the worker runs on an
  // in-memory store (accounts reset on each deploy) — perfect for trying it
  // out with zero setup. For persistence run:
  //   npx wrangler kv namespace create USERS
  // then paste the printed id below and re-deploy.
  //
  // "kv_namespaces": [
  //   { "binding": "STORE", "id": "<YOUR-KV-NAMESPACE-ID>" }
  // ],

  // Institute invitation codes (comma separated). Defaults if unset:
  //   ADMIN_CODES:      MUDREXX-ADMIN,ADMIN-2024,ADMIN777,MEDRIX888,ADMIN
  //   SUPER_ADMIN_CODES: MUDREXX-SUPER,SUPER-2024
  // Override here or in the Cloudflare dashboard (Settings -> Variables).
  // "vars": {
  //   "ADMIN_CODES": "CODE1,CODE2",
  //   "SUPER_ADMIN_CODES": "BOSS1"
  // },

  "observability": {
    "enabled": true
  }
}
