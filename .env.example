# ── Hype Coin Control · environment template ─────────────────────────────
# Copy to .env and fill in real values. The app ships with safe defaults
# for local / study use, so it runs out of the box without this file.

# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=12h

# CORS (comma separated origins, or * for dev)
CLIENT_ORIGIN=http://localhost:5173

# ── Placeholder integrations (design hooks — swap for real providers) ────
AI_API_KEY=
AI_API_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@hypecoincontrol.io
