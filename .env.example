# Northflank injects PORT automatically. The app defaults to 8080.
PORT=8080
# Telegram support destination shown by the global Contact us button.
VITE_TELEGRAM_URL=https://t.me/mudrexxearn_support

# Server-only secret for /api/admin/config. Do not expose this as VITE_*.
ADMIN_API_KEY=replace-with-a-long-random-secret
