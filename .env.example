# Local API port. The app defaults to 8080.
PORT=8080

# Optional split API deployment. Leave empty to use same-origin /api routes.
# Production builds (.env.production) pin this to the backend Worker:
#   https://web-back.blackb0ss1.workers.dev
# Override here for local runs against a different origin (empty = the Vite
# dev/preview proxy on http://localhost:8080).
VITE_API_URL=
# Optional gateway API key. Sent as X-API-Key (never commit the real value).
VITE_API_KEY=

# Telegram support destination shown by the global Contact us button.
VITE_TELEGRAM_URL=https://t.me/MEDRIXEARN
