{
  // ---------------------------------------------------------------------------
  // Canonical deploy configuration — repo root.
  //
  // The `trading` Worker is a STATIC site: it serves the built SPA (./dist) with
  // single-page-application fallback and nothing else. There is no Worker
  // script and no API handler — the in-Worker API backend was removed on
  // purpose (audit: "API handler in trading Worker — should be removed,
  // static only"). The backend is `server.mjs` (Express, Docker) deployed
  // separately; point the frontend at it with the build-time VITE_API_URL
  // variable, or self-host the SPA + API together with `npm start`.
  //
  // Symptom of a request that still hits this Worker expecting an API:
  //   GET  /api/health            -> index.html (SPA fallback)
  //   POST /api/auth/register     -> 405 Method Not Allowed
  //                               (static assets only allow GET/HEAD)
  // That is the intended behaviour — `npm run verify:deployed` asserts it.
  //
  // Deploy:  npm run deploy   (= npm run build && wrangler deploy -c wrangler.jsonc)
  // Verify:  npm run verify:deployed
  // ---------------------------------------------------------------------------
  "$schema": "node_modules/wrangler/config-schema.json",

  // Must match the Worker in the Cloudflare dashboard. `trading` is the Worker
  // that serves https://trading.rufflocrm.workers.dev — a different name here
  // makes Workers Builds deploy somewhere else (or fail the name check).
  "name": "trading",

  "compatibility_date": "2026-08-20",

  // Static assets only — no "main" entry point, so no code runs on the Worker.
  //
  // No bindings by design: **no D1**, no KV, no service bindings, no vars or
  // secrets. All API calls go to the backend Worker origin pinned in
  // .env.production (VITE_API_URL=https://web-back.blackb0ss1.workers.dev).
  // Do not add a d1_databases / kv_namespaces / binding block here.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
