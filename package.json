{
  "name": "mudrexx-earn",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mudrexx Earn — responsive crypto market and demo trading experience",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node server.mjs\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node --test test/api.test.mjs",
    "deploy": "npm run build && wrangler deploy -c trading-worker/wrangler.jsonc",
    "worker:deploy": "npm --prefix trading-worker run deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wrangler": "^4.125.0"
  }
}
